# ── Environment Configuration ─────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=4000

# ── Database ──────────────────────────────────────
# Local dev  → tunnel VPS PostgreSQL to port 5432:
#   ssh -L 5432:127.0.0.1:5432 -p 443 root@<VPS_IP> -i ~/.ssh/id_ed25519
# Production → direct localhost:5432 on the VPS.
DATABASE_URL="postgresql://poorna_user:PASSWORD@127.0.0.1:5432/poornasree_ai"

# ── Auth ──────────────────────────────────────────
JWT_SECRET="generate-a-real-secret-here"
JWT_EXPIRES_IN="7d"

# ── CORS ──────────────────────────────────────────
# Dev default: http://localhost:3000 (Next.js)
# Prod: set to your actual domain
CORS_ORIGIN="http://localhost:3000"

# ── Integration webhook (optional) ───────────────
# See public/Doc/TICKET_INTEGRATION.md
# INTEGRATION_WEBHOOK_URL=http://127.0.0.1:9090/webhook

# ── HR engineers roster sync (optional) ───────────
# See public/Doc/HR_ENGINEERS_SYNC.md
# HR_ENGINEERS_URL=http://145.223.18.143/hr_api_v2/public/engineers
# HR_SYNC_MANAGER_ID=

# ── WhatsApp Cloud API (optional — required for live WhatsApp) ─────────────
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_VERIFY_TOKEN=
# First outbound engineer onboarding — see public/Doc/WHATSAPP_ENGINEER_SETUP_TEMPLATE.md
# WA_ENGINEER_SETUP_TEMPLATE=engineer_account_setup
# WA_ENGINEER_SETUP_TEMPLATE_LANG=en
# FRONTEND_URL=https://poornasree.pydart.com

# ── CI pull deploy (optional — see DEPLOY.md) ─────────────────────────────
# IMAGE_TAG=AIpoorna
# API_IMAGE=ghcr.io/pydart-hub/poornasree-ai-api:AIpoorna
# WEB_IMAGE=ghcr.io/pydart-hub/poornasree-ai-web:AIpoorna
