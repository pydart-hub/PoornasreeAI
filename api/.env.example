# ── Backend Environment Configuration (.env) ──────────────────────────────────
# Copy this file to api/.env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev  → direct localhost:5432 (or SSH tunnel to VPS PostgreSQL):
#   ssh -L 5432:127.0.0.1:5432 -p 443 root@<VPS_IP> -i ~/.ssh/id_ed25519
# Production → postgresql://poorna_user:<PASSWORD>@db:5432/poornasree_ai (Docker)
DATABASE_URL="postgresql://poorna_user:PASSWORD@127.0.0.1:5432/poornasree_ai"

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET="generate-a-real-secret-here-via-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# ── CORS & Public URLs ────────────────────────────────────────────────────────
# Dev default: http://localhost:3000 (Next.js frontend)
# Prod: https://ai.poornasreecloud.com
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="https://ai.poornasreecloud.com"
GOOGLE_REVIEW_URL="https://www.google.com/search?q=poornasree+equipments+rating#lrd=0x3b087304d11a5893:0xbd3ca8c2644804ef,3,,,,"

# ── Groq LLM API (Primary Conversational & RAG Engine) ────────────────────────
# Super Admin dashboard (/super-admin) can also configure these dynamically.
GROQ_API_KEY=""
CHATBOT_MODE="legacy_fsm"              # "groq" | "legacy_fsm"
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_AGENT="llama-3.3-70b-versatile"
GROQ_MAX_TOKENS_REPLY=600

# ── WhatsApp Cloud API (Meta Cloud) ───────────────────────────────────────────
# Required for live customer chat, engineer dispatch, and OTP delivery.
WA_BUSINESS_ACCOUNT_ID=""
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_VERIFY_TOKEN=""

# Approved Meta WhatsApp Templates:
WA_ENGINEER_SETUP_TEMPLATE="poornasree_engineer_activation_v2"
WA_ENGINEER_SETUP_TEMPLATE_LANG="en"
WA_ENGINEER_TICKET_TEMPLATE="engineer_ticket_assigned"
WA_ENGINEER_TICKET_TEMPLATE_LANG="en"

# ── Public OTP Endpoint Security ──────────────────────────────────────────────
# Shared secret for GET /api/public/tickets/:id/active-otp (Header: X-OTP-Secret).
# Leave empty to disable the endpoint completely (recommended in production).
PUBLIC_OTP_SECRET=""

# ── External Integrations (Optional) ──────────────────────────────────────────
# Webhook to post normalized ticket events to n8n / external workflow systems:
# INTEGRATION_WEBHOOK_URL="https://your-n8n.com/webhook/poornasree-tickets"

# HR Engineers Roster Sync API:
# HR_ENGINEERS_URL="http://145.223.18.143/hr_api_v2/public/engineers"
# HR_SYNC_MANAGER_ID=""

# ── Vector Search & Embeddings ────────────────────────────────────────────────
QDRANT_URL="http://127.0.0.1:6333"
OLLAMA_URL="http://127.0.0.1:11434"
