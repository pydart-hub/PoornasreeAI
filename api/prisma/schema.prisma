generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  firstName        String
  lastName         String?
  // Roles: customer | service | service_engineer | service_manager | assistant_service_manager | dealer | admin | sales
  role             String             @default("customer")
  createdAt        DateTime           @default(now())

  // Dealer warranty (months) — only relevant for dealer role
  warrantyMonths   Int?

  // WhatsApp number (international format, e.g. 919876543210) — for engineers
  whatsappNumber   String?

  // Engineer self-onboarding: one-time set-password token (SHA-256 hex, 7-day expiry)
  setPasswordToken       String?   @unique
  setPasswordTokenExpiry DateTime?

  // Pincode assignment (for engineers and dealers — legacy single-pincode FK)
  pincodeId        String?
  pincode          Pincode?           @relation("UserPincode", fields: [pincodeId], references: [id])

  // Engineer → owning manager (set when service_manager creates a service_engineer)
  managerId        String?
  manager          User?              @relation("EngineerManager", fields: [managerId], references: [id])
  managedEngineers User[]             @relation("EngineerManager")

  // Pincode-based routing relations
  engineerPincodes Pincode[]          @relation("EngineerPincodes")

  // HR app roster sync (external hr_api_v2 engineers endpoint)
  hrEngineerId  Int?      @unique
  hrSyncedAt    DateTime?

  // Legacy relations (kept — not removed yet)
  conversations    Conversation[]
  feedback         TrainingFeedback[]
  documents        Document[]
  customerRequests SupportRequest[]   @relation("CustomerRequests")
  engineerRequests SupportRequest[]   @relation("EngineerRequests")
  supportMessages  SupportMessage[]

  // Ticket relations
  customerTickets       Ticket[]           @relation("CustomerTickets")
  dealerTickets         Ticket[]           @relation("DealerTickets")
  managerTickets        Ticket[]           @relation("ManagerTickets")
  engineerTickets       Ticket[]           @relation("EngineerTickets")
  assignedDealerTickets Ticket[]           @relation("AssignedDealerTickets")

  // R&D videos uploaded by this user
  rdVideos         RdVideo[]

  // Work reports submitted by this dealer
  workReports      WorkReport[]       @relation("DealerWorkReports")
}

model Conversation {
  id              String             @id @default(uuid())
  userId          String
  title           String?
  status          String             @default("open")      // open | in_progress | resolved | escalated
  escalated       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  feedback        TrainingFeedback[]
  supportRequests SupportRequest[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user" | "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ── Training Feedback ───────────────────────────────────────────────────────
// Stores service-manager corrections for future AI training.
model TrainingFeedback {
  id              String       @id @default(uuid())
  conversationId  String
  messageId       String?
  correctedAnswer String       @db.Text
  createdById     String
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy       User         @relation(fields: [createdById], references: [id])
}

// ── Document (foundation only — upload logic pending) ──────────────────────
model Document {
  id           String          @id @default(uuid())
  title        String
  filePath     String
  documentType String          @default("service")    // "service" | "customer"
  uploadedById String
  createdAt    DateTime        @default(now())

  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  chunks       DocumentChunk[]
}

// ── Document Chunks for RAG vector search ──────────────────────────────────
model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String   @db.Text
  vectorId   String
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ── Video Recommendation Resources ─────────────────────────────────────────
// Admin-curated YouTube videos linked to product/topic keywords.
// When a customer or service engineer asks a question, the backend searches
// these videos by keyword overlap and returns matching ones alongside the
// AI answer.
model VideoResource {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  youtubeUrl  String
  keywords    String   @db.Text  // comma-separated lowercase e.g. "vibro,stirrer,calibration"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Support Request Queue ───────────────────────────────────────────────────
// Customer escalates to human service engineer via this model.
model SupportRequest {
  id             String           @id @default(uuid())
  customerId     String
  engineerId     String?
  conversationId String
  problem        String           @db.Text
  machineName    String?
  status         String           @default("pending")   // pending | active | resolved
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer       User             @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  engineer       User?            @relation("EngineerRequests", fields: [engineerId], references: [id])
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatMessages   SupportMessage[]
}

// ── Support Chat Messages (engineer ↔ customer real-time) ──────────────────
model SupportMessage {
  id               String         @id @default(uuid())
  supportRequestId String
  senderId         String
  content          String         @db.Text
  createdAt        DateTime       @default(now())

  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  sender           User           @relation(fields: [senderId], references: [id])
}

// ── Pincode (geographic routing zone) ─────────────────────────────────────
model Pincode {
  id        String   @id @default(uuid())
  code      String   @unique
  place     String?
  district  String?
  state     String?
  createdAt DateTime @default(now())

  // Legacy: users assigned to this pincode via User.pincodeId FK
  users     User[]   @relation("UserPincode")
  tickets   Ticket[]

  // Engineers assigned to this zone (many-to-many)
  engineers User[]   @relation("EngineerPincodes")
}

// ── Ticket Status Enum ────────────────────────────────────────────────────
enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_OTP
  CLOSED
}

// ── Ticket Owner Type Enum ────────────────────────────────────────────────
enum TicketOwnerType {
  MANAGER
  DEALER
}

// ── Ticket (core entity — replaces SupportRequest) ────────────────────────
// Status flow: OPEN → ASSIGNED → IN_PROGRESS → PENDING_OTP → CLOSED
model Ticket {
  id                 String    @id @default(uuid())
  ticketNumber       String    @unique  // e.g. TKT-20260317-001

  // Routing / Ownership
  ownerType          TicketOwnerType @default(MANAGER)
  ownerId            String?   // user ID of the owner (manager or dealer)

  // Parties
  customerId         String
  dealerId           String?   // null if customer raised directly (origin/source dealer)
  assignedManagerId  String?
  assignedEngineerId String?
  assignedDealerId   String?   // dealer assigned by service manager for field handling

  // Routing
  pincodeId          String?

  // Location (auto-detected from India Pincode API)
  place              String?
  district           String?
  state              String?

  // Problem
  problemDescription String    @db.Text
  issueDescription   String?   @db.Text  // the actual customer complaint (chat-submitted)
  machineName        String?
  machineSerialNumber String?  // denormalized for display
  machineProductCode String?   // product_code from Passtest API
  machineCustomer    String?   // customer name from Passtest API
  machineAddress1    String?   // Address1 from Passtest API
  machineAddress2    String?   // Address2 from Passtest API
  machineInvoiceNo   String?   // InvNo from Passtest API
  machineInvoiceDate String?   // InvDate from Passtest API
  machineWarranty    Int?      // WARRANTY months from Passtest API
  customerAddress    String?   // Customer's actual service address (entered during ticket creation)
  phoneNumber        String?   // link back to simulate chat (for OTP delivery)

  // Passtest / dealer workflow
  passtestMatched    Boolean   @default(false)
  dealerResponse     String?   // pending | accepted | rejected | completed
  dealerRespondedAt  DateTime?

  // Lifecycle
  status             TicketStatus @default(OPEN)

  // OTP closure
  otpCodeHash        String?
  otpExpiresAt       DateTime?
  otpVerified        Boolean   @default(false)
  otpAttempts        Int       @default(0)

  // Media (WhatsApp video URLs stored as JSON array)
  mediaUrls          Json      @default("[]")

  // Feedback
  feedbackRating     Int?      // 1–5
  feedbackComment    String?   @db.Text  // satisfaction notes / yes-no
  feedbackSubmittedAt DateTime?

  // Timestamps
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  firstEngineeredAt  DateTime?
  closedAt           DateTime?

  // Relations
  customer           User      @relation("CustomerTickets",  fields: [customerId],          references: [id], onDelete: Cascade)
  dealer             User?     @relation("DealerTickets",    fields: [dealerId],             references: [id])
  assignedManager    User?     @relation("ManagerTickets",   fields: [assignedManagerId],    references: [id])
  assignedEngineer   User?     @relation("EngineerTickets",  fields: [assignedEngineerId],   references: [id])
  assignedDealer     User?     @relation("AssignedDealerTickets", fields: [assignedDealerId], references: [id])
  pincode            Pincode?  @relation(fields: [pincodeId],            references: [id])
  workReport         WorkReport?
}

// ── Simulate Message (persisted WhatsApp-simulator chat) ──────────────────
// Stores every user/bot/system message in the test-chat interface so that
// history survives page refreshes and OTP codes can be pushed to the customer.
model SimulateMessage {
  id          String   @id @default(uuid())
  phoneNumber String
  role        String   // "user" | "bot" | "system"
  content     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([phoneNumber, createdAt])
}

// ── Troubleshooting Template ─────────────────────────────────────────────
// Admin-defined step-by-step resolution guides keyed by problemType.
model TroubleshootingTemplate {
  id          String   @id @default(uuid())
  problemType String   @unique             // e.g. "power_issue", "no_display"
  title       String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  // audience: "customer" = customer WhatsApp only, "engineer" = service engineers only, "both" = all
  audience    String   @default("customer")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       TroubleshootingStep[]
}

// ── Troubleshooting Step ─────────────────────────────────────────────────
// Ordered steps within a template.
model TroubleshootingStep {
  id          String @id @default(uuid())
  templateId  String
  stepNumber  Int
  stepContent String @db.Text

  template    TroubleshootingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepNumber])
}

// ── Troubleshooting Session ──────────────────────────────────────────────
// Tracks a user walking through a troubleshooting template.
// Only ONE active session per (phoneNumber + serialNumber).
model TroubleshootingSession {
  id           String   @id @default(uuid())
  phoneNumber  String
  serialNumber String
  problemType  String
  currentStep  Int      @default(1)
  status       String   @default("ACTIVE")  // ACTIVE | COMPLETED | ESCALATED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber, serialNumber, status], name: "idx_session_lookup")
}

// ── Conversation Session (WhatsApp simulation gatekeeper) ────────────────
// V-Guard-style FSM per phone number. One active session per phoneNumber.
// States: GREETING | MAIN_MENU | PRODUCT_SELECT | TROUBLESHOOTING |
//         ESCALATION_NAME | ESCALATION_PLACE | ESCALATION_PINCODE |
//         ESCALATION_SERIAL | COMPLETED
model ConversationSession {
  id             String   @id @default(uuid())
  phoneNumber    String
  state          String   @default("GREETING")
  isRegistered   Boolean  @default(false)
  serialNumber   String?
  machineId      String?
  metadata       Json?    // flow-specific payload (productId, issueDescription, escalation fields, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phoneNumber, state], name: "idx_convo_session_lookup")
}

// ── Product Catalogue ────────────────────────────────────────────────────
// Admin-managed list of products shown to customers via WhatsApp "View Our Products".
model Product {
  id            String   @id @default(uuid())
  name          String
  detail        String?  @db.Text
  price         String?
  imageUrl      String?
  contactNumber String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Machine Registry ────────────────────────────────────────────────────
// Machines registered by admin. Customers validate serial during registration.
model Machine {
  id           String   @id @default(uuid())
  serialNumber String   @unique
  modelName    String
  specs        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Branding (singleton — only row 0) ───────────────────────────────────
// Admin-editable company branding applied across the frontend.
model Branding {
  id           String  @id @default(uuid())
  companyName  String  @default("Poornasree")
  logoUrl      String? // relative path or URL
  address      String? @db.Text
  primaryColor String  @default("#2563eb")
  tagline      String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── R&D Video (confidential internal videos for engineers) ──────────────
// Uploaded by admin, accessible to service_engineer + admin roles only.
model RdVideo {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  filePath     String   // relative upload path on server
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

// ── Marketing Lead ───────────────────────────────────────────────────────
// Leads (WhatsApp contacts) imported or added manually by admin for campaigns.
model MarketingLead {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique  // international format e.g. 919876543210
  source    String   @default("manual")  // manual | csv
  tags      String?  // comma-separated optional tags
  createdAt DateTime @default(now())

  campaignLeads BrandingCampaignLead[]
}

// ── Branding Campaign ────────────────────────────────────────────────────
// A marketing broadcast: admin picks an image/collage + caption + leads.
model BrandingCampaign {
  id          String    @id @default(uuid())
  title       String
  imageUrl    String    // uploaded collage/image (relative path)
  caption     String?   @db.Text
  status      String    @default("draft")  // draft | sending | sent
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads       BrandingCampaignLead[]
}

// ── Branding Campaign Lead ───────────────────────────────────────────────
// Join: which leads belong to a campaign, with per-lead delivery status.
model BrandingCampaignLead {
  id         String    @id @default(uuid())
  campaignId String
  leadId     String
  status     String    @default("pending")  // pending | sent | failed
  sentAt     DateTime?

  campaign   BrandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       MarketingLead    @relation(fields: [leadId],     references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
}

// ── Work Report ──────────────────────────────────────────────────────────
// Created by dealer (engineers using dealer credentials) during/after a ticket.
// One-to-one with Ticket.
model WorkReport {
  id                     String   @id @default(uuid())
  ticketId               String   @unique
  dealerId               String
  problemDiagnosed       String?  @db.Text
  workDone               String?  @db.Text
  warrantyClaimRequested Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  ticket                 Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  dealer                 User             @relation("DealerWorkReports", fields: [dealerId], references: [id])
  parts                  ReplacedPart[]
  images                 WorkReportImage[]
}

// ── Replaced Part ────────────────────────────────────────────────────────
// Parts replaced during a service visit, linked to a WorkReport.
model ReplacedPart {
  id           String     @id @default(uuid())
  workReportId String
  partName     String
  partNumber   String?
  quantity     Int        @default(1)
  createdAt    DateTime   @default(now())

  workReport   WorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)
}

// ── Work Report Image ────────────────────────────────────────────────────
// Photos of replaced parts, uploaded by dealer.
model WorkReportImage {
  id           String     @id @default(uuid())
  workReportId String
  url          String
  fileName     String
  createdAt    DateTime   @default(now())

  workReport   WorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)
}