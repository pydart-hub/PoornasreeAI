# ── Copy this file to .env and fill in values before running docker compose ──

# PostgreSQL credentials
POSTGRES_USER=poorna_user
POSTGRES_PASSWORD=
POSTGRES_DB=poornasree_ai

# JWT signing secret (generate a strong random string, e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS: set to your public domain in production, e.g. https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Next.js public API URL — leave empty for Docker (proxy rewrites handle it).
# Set only if the API is on a different domain/origin than the frontend.
NEXT_PUBLIC_API_URL=
