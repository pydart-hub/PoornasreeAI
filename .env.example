# ── Copy this file to .env and fill in values before running docker compose ──

# PostgreSQL credentials
POSTGRES_USER=poorna_user
POSTGRES_PASSWORD=
POSTGRES_DB=poornasree_ai

# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS: set to your public domain in production, e.g. https://ai.poornasreecloud.com
CORS_ORIGIN=https://ai.poornasreecloud.com

# Next.js public API URL — leave empty for Docker (proxy rewrites handle it).
NEXT_PUBLIC_API_URL=

# Groq LLM API (Engineer Training Video AI Search)
GROQ_API_KEY=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# All five vars below are required for live WhatsApp (OTP, notifications, bot).
# Get from Meta Business Manager → WhatsApp → API Setup.
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
# Approved Meta templates (must exist in your Meta Business account):
WA_ENGINEER_SETUP_TEMPLATE=poornasree_engineer_activation_v2
WA_ENGINEER_SETUP_TEMPLATE_LANG=en
WA_ENGINEER_TICKET_TEMPLATE=engineer_ticket_assigned
WA_ENGINEER_TICKET_TEMPLATE_LANG=en

# Frontend URL — used in WhatsApp links (set-password, ticket links)
FRONTEND_URL=https://ai.poornasreecloud.com

# ── Integration webhook (optional) ────────────────────────────────────────────
# POST ticket lifecycle events to your n8n or external system.
# Leave empty (default) to disable.
# INTEGRATION_WEBHOOK_URL=https://your-n8n.com/webhook/poornasree-tickets

# ── OTP endpoint security ─────────────────────────────────────────────────────
# Shared secret for GET /api/public/tickets/:id/active-otp
# Must be sent as: X-OTP-Secret: <value>
# Leave empty to disable the endpoint entirely (recommended unless you need it).
# Generate: openssl rand -hex 24
PUBLIC_OTP_SECRET=
